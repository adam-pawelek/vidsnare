  "version": "0.1.0",
  "description": "Download videos and audio from YouTube on Windows and Linux.",
  "license": "MIT",
  "author": "VidSnare contributors",
  "homepage": "https://github.com/OWNER/vidsnare",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
